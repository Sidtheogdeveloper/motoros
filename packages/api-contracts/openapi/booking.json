  "components": {
    "schemas": {
      "Input": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "serviceCategoryId": {
            "type": "string",
            "format": "uuid"
          },
          "requestedStartTime": {
            "type": "string",
            "format": "date-time"
          },
          "estimatedDurationMinutes": {
            "type": "integer",
            "format": "int32",
            "maximum": 480,
            "minimum": 15
          },
          "customerComplaint": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "bookingSource": {
            "type": "string",
            "minLength": 1
          },
          "assignedTechnicianId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "bookingSource",
          "branchId",
          "customerComplaint",
          "customerId",
          "requestedStartTime",
          "serviceCategoryId",
          "vehicleId"
        ]
      },
      "Change": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "note",
          "version"
        ]
      }
    },
