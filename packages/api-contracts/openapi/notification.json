  "components": {
    "schemas": {
      "Action": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 10
          }
        },
        "required": [
          "reason"
        ]
      },
      "Reminder": {
        "type": "object",
        "properties": {
          "sourceEventId": {
            "type": "string",
            "format": "uuid"
          },
          "producer": {
            "type": "string",
            "minLength": 1,
            "pattern": "booking|billing|workorder"
          },
          "templateKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "appointment-reminder|estimate-reminder|collection-reminder|maintenance-reminder|outstanding-payment-reminder"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 10
          }
        },
        "required": [
          "dueAt",
          "producer",
          "reason",
          "sourceEventId",
          "templateKey"
        ]
      }
    },
