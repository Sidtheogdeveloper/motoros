resource "aws_appautoscaling_policy" "notification_backlog" {
  count              = contains(keys(local.images), "notification") ? 1 : 0
  name               = "notification-queue-backlog"
  policy_type        = "StepScaling"
  resource_id        = aws_appautoscaling_target.app["notification"].resource_id
  scalable_dimension = "ecs:service:DesiredCount"
  service_namespace  = "ecs"
  step_scaling_policy_configuration {
    adjustment_type         = "ChangeInCapacity"
