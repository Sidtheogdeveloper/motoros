      "Condition" = {
        "StringEquals" = {
          "iam:PassedToService" = "ecs-tasks.amazonaws.com"
        }
      }
      }, {
      "Effect"   = "Allow"
      "Action"   = ["logs:DescribeLogGroups"]
      "Resource" = "*"
      "Condition" = {
        "StringEquals" = {
          "aws:RequestedRegion" = var.region
        }
      }
      }, {
      "Effect"   = "Allow"
      "Action"   = ["logs:DescribeLogStreams"]
      "Resource" = "arn:aws:logs:${var.region}:${var.account_id}:log-group:/motoros/${var.environment}/*"
      }, {
      "Effect"   = "Allow"
      "Action"   = ["ecs:RegisterTaskDefinition"]
      "Resource" = "*"
      "Condition" = {
        "StringEquals" = {
          "aws:RequestTag/Project"     = "MotorOS"
          "aws:RequestTag/Environment" = var.environment
        }
      }
    }]
  }
  rds_monitoring_trust = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect" = "Allow"
      "Principal" = {
        "Service" = "monitoring.rds.amazonaws.com"
      }
      "Action" = "sts:AssumeRole"
      "Condition" = {
        "StringEquals" = {
          "aws:SourceAccount" = var.account_id
        }
        "ArnEquals" = {
          "aws:SourceArn" = "arn:aws:rds:${var.region}:${var.account_id}:db:${local.name}"
        }
      }
    }]
  }
  audit_policy = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect"    = "Deny"
      "Principal" = "*"
      "Action"    = "s3:*"
      "Resource"  = [aws_s3_bucket.audit.arn, "${aws_s3_bucket.audit.arn}/*"]
      "Condition" = {
        "Bool" = {
          "aws:SecureTransport" = "false"
        }
      }
      }, {
      "Effect" = "Allow"
      "Principal" = {
        "Service" = "logging.s3.amazonaws.com"
      }
      "Action"   = "s3:PutObject"
      "Resource" = "${aws_s3_bucket.audit.arn}/s3-access/*"
      "Condition" = {
        "StringEquals" = {
          "aws:SourceAccount" = var.account_id
        }
        "ArnEquals" = {
          "aws:SourceArn" = aws_s3_bucket.private.arn
        }
      }
      }, {
      "Effect" = "Allow"
      "Principal" = {
        "Service" = "logdelivery.elasticloadbalancing.amazonaws.com"
      }
      "Action"   = "s3:PutObject"
      "Resource" = "${aws_s3_bucket.audit.arn}/alb/AWSLogs/${var.account_id}/*"
      "Condition" = {
        "StringEquals" = {
          "aws:SourceAccount" = var.account_id
        }
      }
      }, {
      "Effect" = "Allow"
      "Principal" = {
        "Service" = "cloudtrail.amazonaws.com"
      }
      "Action"   = "s3:GetBucketAcl"
      "Resource" = aws_s3_bucket.audit.arn
      "Condition" = {
        "StringEquals" = {
          "aws:SourceArn" = "arn:aws:cloudtrail:${var.region}:${var.account_id}:trail/${local.name}"
        }
      }
      }, {
      "Effect" = "Allow"
      "Principal" = {
        "Service" = "cloudtrail.amazonaws.com"
      }
      "Action"   = "s3:PutObject"
      "Resource" = "${aws_s3_bucket.audit.arn}/cloudtrail/AWSLogs/${var.account_id}/*"
      "Condition" = {
        "StringEquals" = {
          "aws:SourceArn" = "arn:aws:cloudtrail:${var.region}:${var.account_id}:trail/${local.name}"
          "s3:x-amz-acl"  = "bucket-owner-full-control"
        }
      }
    }]
  }
  flow_trust = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect" = "Allow"
      "Principal" = {
        "Service" = "vpc-flow-logs.amazonaws.com"
      }
      "Action" = "sts:AssumeRole"
      "Condition" = {
        "StringEquals" = {
          "aws:SourceAccount" = var.account_id
        }
      }
    }]
  }
  flow_policy = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect"   = "Allow"
      "Action"   = ["logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"]
      "Resource" = "${aws_cloudwatch_log_group.flows.arn}:*"
    }]
  }
  trail_topic_policy = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect" = "Allow"
      "Principal" = {
        "Service" = "cloudtrail.amazonaws.com"
      }
      "Action"   = "sns:Publish"
      "Resource" = aws_sns_topic.audit.arn
      "Condition" = {
        "StringEquals" = {
          "aws:SourceArn" = "arn:aws:cloudtrail:${var.region}:${var.account_id}:trail/${local.name}"
        }
      }
    }]
  }
  trail_trust = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect" = "Allow"
      "Principal" = {
        "Service" = "cloudtrail.amazonaws.com"
      }
      "Action" = "sts:AssumeRole"
      "Condition" = {
        "StringEquals" = {
          "aws:SourceAccount" = var.account_id
        }
      }
    }]
  }
  trail_log_policy = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect"   = "Allow"
      "Action"   = ["logs:CreateLogStream", "logs:PutLogEvents"]
      "Resource" = "${aws_cloudwatch_log_group.trail.arn}:*"
    }]
  }
  alert_policy = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect" = "Allow"
      "Principal" = {
        "Service" = ["cloudwatch.amazonaws.com", "events.amazonaws.com"]
      }
      "Action"   = "sns:Publish"
      "Resource" = aws_sns_topic.alerts.arn
      "Condition" = {
        "StringEquals" = {
          "aws:SourceAccount" = var.account_id
        }
      }
    }]
  }
  mesh_key_policy = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect"   = "Allow"
      "Action"   = ["kms:GenerateDataKey", "kms:Decrypt", "kms:DescribeKey"]
      "Resource" = aws_kms_key.environment.arn
      "Condition" = {
        "StringEquals" = {
          "kms:ViaService" = "secretsmanager.${var.region}.amazonaws.com"
        }
      }
    }]
  }
  migration_execution_policies = { for name, secret in aws_secretsmanager_secret.migration : name => { Version = "2012-10-17", Statement = [{ Effect = "Allow", Action = ["ecr:GetAuthorizationToken"], Resource = "*" }, { Effect = "Allow", Action = ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"], Resource = aws_ecr_repository.service[name].arn }, { Effect = "Allow", Action = ["logs:CreateLogStream", "logs:PutLogEvents"], Resource = "${aws_cloudwatch_log_group.service[name].arn}:*" }, { Effect = "Allow", Action = ["secretsmanager:GetSecretValue"], Resource = secret.arn }, { Effect = "Allow", Action = ["kms:Decrypt"], Resource = aws_kms_key.environment.arn }] } }
  regional_metadata_actions    = ["ec2:Describe*", "ecs:Describe*", "ecs:List*", "rds:Describe*", "rds:ListTagsForResource", "elasticache:Describe*", "elasticache:ListTagsForResource", "logs:DescribeLogGroups", "logs:DescribeLogStreams", "logs:ListTagsLogGroup", "cloudwatch:DescribeAlarms", "cloudwatch:GetDashboard", "cloudwatch:ListTagsForResource", "cognito-idp:DescribeUserPool", "cognito-idp:DescribeUserPoolClient", "cognito-idp:DescribeUserPoolDomain", "cognito-idp:DescribeResourceServer", "cognito-idp:GetUserPoolMfaConfig", "cognito-idp:ListTagsForResource", "ecr:DescribeRepositories", "ecr:GetRepositoryPolicy", "ecr:GetLifecyclePolicy", "ecr:GetLifecyclePolicyPreview", "ecr:ListTagsForResource", "acm-pca:DescribeCertificateAuthority", "acm-pca:GetCertificateAuthorityCertificate", "acm:DescribeCertificate", "acm:ListTagsForCertificate", "servicediscovery:GetNamespace", "servicediscovery:ListTagsForResource", "cloudtrail:GetTrail", "cloudtrail:GetTrailStatus", "cloudtrail:GetEventSelectors", "cloudtrail:GetInsightSelectors", "cloudtrail:ListTags", "wafv2:GetWebACL", "wafv2:GetWebACLForResource", "wafv2:GetLoggingConfiguration", "wafv2:ListTagsForResource"]
  plan_metadata_policy = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect"   = "Allow"
      "Action"   = local.regional_metadata_actions
      "Resource" = "*"
      "Condition" = {
        "StringEquals" = {
          "aws:RequestedRegion" = var.region
        }
      }
      }, {
      "Effect"   = "Allow"
      "Action"   = ["iam:GetRole", "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies", "iam:ListRoleTags"]
      "Resource" = "arn:aws:iam::${var.account_id}:role/${local.name}-*"
      }, {
      "Effect"   = "Allow"
      "Action"   = ["kms:DescribeKey", "kms:GetKeyPolicy", "kms:GetKeyRotationStatus", "kms:ListResourceTags"]
      "Resource" = aws_kms_key.environment.arn
      }, {
      "Effect"   = "Allow"
      "Action"   = ["secretsmanager:DescribeSecret", "secretsmanager:GetResourcePolicy"]
      "Resource" = concat([for x in aws_secretsmanager_secret.runtime : x.arn], [for x in aws_secretsmanager_secret.migration : x.arn])
      }, {
      "Effect"   = "Allow"
      "Action"   = ["sns:GetTopicAttributes", "sns:ListTagsForResource", "sns:ListSubscriptionsByTopic", "sns:GetSubscriptionAttributes"]
      "Resource" = "arn:aws:sns:${var.region}:${var.account_id}:${local.name}-*"
      }, {
      "Effect"   = "Allow"
      "Action"   = ["sqs:GetQueueUrl", "sqs:GetQueueAttributes", "sqs:ListQueueTags"]
      "Resource" = "arn:aws:sqs:${var.region}:${var.account_id}:${local.name}-*"
      }, {
      "Effect"   = "Allow"
      "Action"   = ["s3:GetBucketLocation", "s3:GetBucketPolicy", "s3:GetBucketPublicAccessBlock", "s3:GetBucketVersioning", "s3:GetBucketLogging", "s3:GetEncryptionConfiguration", "s3:GetLifecycleConfiguration", "s3:GetBucketCORS", "s3:GetBucketNotification", "s3:GetBucketTagging", "s3:ListBucket"]
      "Resource" = [aws_s3_bucket.private.arn, aws_s3_bucket.audit.arn]
    }]
  }
  state_access_policy = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect"   = "Allow"
      "Action"   = ["s3:ListBucket", "s3:GetBucketLocation"]
      "Resource" = var.state_bucket_arn
      }, {
      "Effect"   = "Allow"
      "Action"   = ["s3:GetObject", "s3:PutObject"]
      "Resource" = "${var.state_bucket_arn}/motoros/${var.environment}/*"
      }, {
      "Effect"   = "Allow"
      "Action"   = ["s3:DeleteObject"]
      "Resource" = "${var.state_bucket_arn}/motoros/${var.environment}/*.tflock"
      }, {
      "Effect"   = "Allow"
      "Action"   = ["kms:Decrypt", "kms:Encrypt", "kms:GenerateDataKey", "kms:DescribeKey"]
      "Resource" = var.state_kms_key_arn
    }]
  }
  initialize_ci_policy = {
    "Version" = "2012-10-17"
    "Statement" = [{
      "Effect"   = "Allow"
      "Action"   = ["ecs:RunTask"]
      "Resource" = "arn:aws:ecs:${var.region}:${var.account_id}:task-definition/${local.name}-initialize:*"
      }, {
      "Effect"   = "Allow"
      "Action"   = ["ecs:DescribeTasks"]
      "Resource" = "arn:aws:ecs:${var.region}:${var.account_id}:task/${local.name}/*"
      }, {
      "Effect"   = "Allow"
      "Action"   = ["iam:PassRole"]
      "Resource" = [aws_iam_role.operator.arn, aws_iam_role.operator_execution.arn]
      "Condition" = {
        "StringEquals" = {
          "iam:PassedToService" = "ecs-tasks.amazonaws.com"
        }
      }
    }]
  }
  readonly_metadata_policy = { Version = "2012-10-17", Statement = [for statement in local.plan_metadata_policy.Statement : merge(statement, { Action = [for action in statement.Action : action if action != "cognito-idp:DescribeUserPoolClient"] })] }
  default_services = {
    "tenant" = {
      "port"   = 8080
      "cpu"    = 512
      "memory" = 1024
    }
    "customer" = {
      "port"   = 8080
