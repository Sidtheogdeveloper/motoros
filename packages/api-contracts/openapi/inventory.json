  "components": {
    "schemas": {
      "Supplier": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "contact": {
            "type": "string",
            "maxLength": 300,
            "minLength": 0
          }
        },
        "required": [
          "name"
        ]
      },
      "Part": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "oemNumber": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "manufacturer": {
            "type": "string",
            "maxLength": 160,
            "minLength": 0
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "compatibilityNotes": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "compatibilityVerified": {
            "type": "boolean"
          },
          "supplierId": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Z]{3}"
          },
          "purchasePrice": {
            "type": "number",
            "minimum": 0
          },
          "sellingPrice": {
            "type": "number",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "category",
          "currency",
          "name",
          "purchasePrice",
          "sellingPrice",
          "sku"
        ]
      },
      "StockCommand": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "partId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          },
          "adjustmentType": {
            "type": "string",
            "pattern": "CORRECTION|DAMAGE|LOSS|SUPPLIER_RETURN|CUSTOMER_RETURN"
          }
        },
        "required": [
          "branchId",
          "partId",
          "quantity",
          "reason"
        ]
      },
      "Transfer": {
        "type": "object",
        "properties": {
          "sourceBranchId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationBranchId": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferLine"
            },
            "maxItems": 100,
            "minItems": 0
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "destinationBranchId",
          "items",
          "note",
          "sourceBranchId"
        ]
      },
      "TransferLine": {
        "type": "object",
        "properties": {
          "partId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "minimum": 0.001
          }
        },
        "required": [
          "partId",
          "quantity"
        ]
      },
      "Change": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "note",
          "version"
        ]
      },
      "ReceiptLine": {
        "type": "object",
        "properties": {
          "partId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "damagedQuantity": {
            "type": "number",
            "minimum": 0
          },
          "missingQuantity": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "damagedQuantity",
          "partId",
          "quantity"
        ]
      },
      "TransferReceipt": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiptLine"
            },
            "maxItems": 100,
            "minItems": 0
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "items",
          "note",
          "version"
        ]
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "partId": {
            "type": "string",
            "format": "uuid"
          },
          "workOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "minimum": 0.001
          }
        },
        "required": [
          "branchId",
          "partId",
          "quantity",
          "workOrderId"
        ]
      },
      "Threshold": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "partId": {
            "type": "string",
            "format": "uuid"
          },
          "reorderLevel": {
            "type": "number",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "branchId",
          "partId",
          "reorderLevel",
          "version"
        ]
      }
    },
    "securitySchemes": {
      "oidcBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
