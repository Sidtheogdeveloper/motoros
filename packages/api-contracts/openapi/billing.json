  "components": {
    "schemas": {
      "Settings": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "pattern": "INR|USD|EUR|GBP"
          },
          "laborHourlyRate": {
            "type": "number",
            "minimum": 0
          },
          "taxRate": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "legalName": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "address": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          },
          "taxLabel": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "registrationReference": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "paymentRequiredBeforeDelivery": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "address",
          "branchId",
          "currency",
          "laborHourlyRate",
          "legalName",
          "taxLabel",
          "taxRate",
          "version"
        ]
      },
      "Action": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 10
          }
        },
        "required": [
          "reason"
        ]
      },
      "PaymentInput": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "minimum": 0.01
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "CASH|UPI|CARD|BANK|OTHER"
          },
          "externalReference": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "pattern": "[A-Za-z0-9_-]+"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "amount",
          "externalReference",
          "invoiceId",
          "method",
          "note"
        ]
      },
      "Change": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "note",
          "version"
        ]
      },
      "RefundInput": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "minimum": 0.01
          },
          "externalReference": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "pattern": "[A-Za-z0-9_-]+"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "amount",
          "externalReference",
          "paymentId",
          "reason"
        ]
      },
      "InvoiceInput": {
        "type": "object",
        "properties": {
          "estimateId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "estimateId"
        ]
      },
      "Credit": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0.01
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 10
          }
        },
        "required": [
          "amount",
          "reason"
        ]
      },
      "EstimateInput": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "workOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "maxItems": 100,
            "minItems": 0
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "branchId",
          "expiresAt",
          "items",
          "note",
          "workOrderId"
        ]
      },
      "Item": {
        "type": "object",
        "properties": {
          "itemType": {
            "type": "string",
            "minLength": 1,
            "pattern": "PART|LABOR|INSPECTION|SERVICE|MISC"
          },
          "partId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          },
          "quantity": {
            "type": "number",
            "minimum": 0.001
          },
          "unitPrice": {
            "type": "number",
            "minimum": 0
          },
          "discountPercent": {
            "type": "number",
            "maximum": 100,
            "minimum": 0
          }
        },
        "required": [
          "description",
          "discountPercent",
          "itemType",
          "quantity",
          "unitPrice"
        ]
      },
      "ApprovalRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9_-]{43}"
          },
          "decision": {
            "type": "string",
            "minLength": 1,
            "pattern": "APPROVED|REJECTED"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "decision",
          "note",
          "token"
        ]
      },
      "ApprovalPreview": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9_-]{43}"
          }
        },
        "required": [
          "token"
        ]
      }
    },
    "securitySchemes": {
      "oidcBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
