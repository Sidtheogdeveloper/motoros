            "in": "header",
            "description": "Selected tenant; independently authorized against current membership. BFF supplies this from the server session.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "booking-controller"
        ],
        "operationId": "create",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,100}$"
            },
            "description": "Required stable key for unchanged retries. Reusing a key with different input returns 409."
          },
          {
            "name": "X-MotorOS-Tenant",
            "in": "header",
            "description": "Selected tenant; independently authorized against current membership. BFF supplies this from the server session.",
