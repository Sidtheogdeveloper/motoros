  "components": {
    "schemas": {
      "Action": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 10
          }
        },
        "required": [
          "reason"
        ]
      },
      "Reminder": {
        "type": "object",
        "properties": {
          "sourceEventId": {
            "type": "string",
            "format": "uuid"
          },
          "producer": {
            "type": "string",
            "minLength": 1,
            "pattern": "booking|billing|workorder"
          },
          "templateKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "appointment-reminder|estimate-reminder|collection-reminder|maintenance-reminder|outstanding-payment-reminder"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 10
          }
        },
        "required": [
          "dueAt",
          "producer",
          "reason",
          "sourceEventId",
          "templateKey"
        ]
      },
      "Confirm": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "version"
        ]
      },
      "NewDraft": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "resourceId": {
            "type": "string",
            "format": "uuid"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "APPOINTMENT_CONFIRMATION",
              "APPOINTMENT_REMINDER",
              "APPOINTMENT_RESCHEDULE",
              "VEHICLE_CHECKED_IN",
              "INSPECTION_COMPLETED",
              "ESTIMATE_APPROVAL",
              "ESTIMATE_EXPLANATION",
              "REPAIR_PROGRESS",
              "READY_FOR_COLLECTION",
              "INVOICE_AVAILABLE",
              "PAYMENT_CONFIRMATION",
              "SERVICE_FOLLOW_UP",
              "MAINTENANCE_REMINDER"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "EMAIL",
              "SMS",
              "WHATSAPP"
            ]
          },
