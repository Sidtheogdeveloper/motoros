check "release_completeness" {
  assert {
    condition     = length(var.image_digests) == 0 || length(var.image_digests) == length(local.services)
    error_message = "Initial rollout requires all nine application digests."
  }
  assert {
    condition     = alltrue([for k, v in var.image_digests : startswith(v, "${var.account_id}.dkr.ecr.${var.region}.amazonaws.com/${local.name}/${k}@sha256:")])
    error_message = "Images must belong to the target environment ECR repositories."
  }
}
